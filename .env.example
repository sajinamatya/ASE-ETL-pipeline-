# -------------------------------------------------------------
# File paths and Directories
# -------------------------------------------------------------
DATASET_PATH=C:\path\to\your\raw\dataset
PROCESSED_DIR=data/processed

# -------------------------------------------------------------
# PostgreSQL Database Configuration
# -------------------------------------------------------------
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=etl_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL used by local Python scripts outside Docker
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/etl_db

# URL used by Airflow and internal Docker containers
DOCKER_DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@db:5432/etl_db

# -------------------------------------------------------------
# Airflow Configuration
# -------------------------------------------------------------
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_here

# -------------------------------------------------------------
# MinIO (S3-compatible) Configuration
# -------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_password
MINIO_SECURE=false

# -------------------------------------------------------------
# API Configuration (JWT Auth)
# -------------------------------------------------------------
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY=your_random_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
